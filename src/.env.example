# =============================================================================
# Weatheria / GridGuard Operations Control — Environment Variable Template
# =============================================================================
# HOW TO USE
#   1. Copy this file:   cp src/.env.example src/.env
#   2. Fill in real values where marked  ← CHANGE THIS
#   3. NEVER commit src/.env to version control — it is in .gitignore
#
# All values below are realistic-looking fakes safe for public repositories.
# Sections match the layers of the stack:
#   A. Django Core          D. ML / Satellite Service
#   B. Database             E. Frontend (JS)
#   C. CORS / Security      F. Auth Simulation Portal
# =============================================================================


# ── A. Django Core ────────────────────────────────────────────────────────────

# Secret key used for cryptographic signing (sessions, CSRF tokens, passwords).
# The value shown is a valid-format fake — replace for ANY non-local deployment.
# Generate a fresh one:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=gx!8@k#m2v$qz^p5n&yw7e*rjt+su9fb0ohcd3il6xa4_w1mn-

# Enable/disable Django debug mode.
# Set to False in staging and production — exposes stack traces when True.
DJANGO_DEBUG=True

# Comma-separated list of hostnames Django will serve (no spaces, no quotes).
# Use * only during local file:// development.
# Production example: api.gridguard.example.com,gridguard.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Django settings module path — should match wsgi.py / asgi.py / manage.py.
# Only override this if you restructure the project layout.
DJANGO_SETTINGS_MODULE=settings

# Port the Django development server (runserver) listens on.
# Must match DJANGO_PORT in app.js and index.html auth script.
DJANGO_PORT=8000

# Timezone used by Django for datetime storage and display.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DJANGO_TIME_ZONE=Asia/Kolkata


# ── B. Database ───────────────────────────────────────────────────────────────

# Database engine. SQLite is the default for local dev (no server needed).
# Switch to django.db.backends.postgresql for staging/production.
DJANGO_DB_ENGINE=django.db.backends.sqlite3

# SQLite: path to the .sqlite3 file relative to src/backend/
# PostgreSQL: database name (ignored for SQLite)
DJANGO_DB_NAME=db.sqlite3

# PostgreSQL / MySQL only — leave blank for SQLite.
DJANGO_DB_USER=gridguard_app
DJANGO_DB_PASSWORD=Str0ng!Passw0rd#GridGuard2025
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432


# ── C. CORS / Security ───────────────────────────────────────────────────────

# Allow ALL origins to call the API.
# Set to True for local file:// testing; False for any deployed environment.
DJANGO_CORS_ALLOW_ALL_ORIGINS=True

# Explicit allowlist — only read when DJANGO_CORS_ALLOW_ALL_ORIGINS=False.
# Add the Live Server origin and any deployed frontend domain.
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# CSRF trusted origins — needed when Django receives POST/PUT/DELETE from a
# browser origin different from the API origin (e.g. file:// or a CDN URL).
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Set to True in production to enforce HTTPS-only cookies.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False


# ── D. ML / Satellite Service ────────────────────────────────────────────────

# Absolute or workspace-relative path to the pre-trained RandomForest model.
# Default resolves to src/backend/ml_service/weather_rainfall_model.pkl
# via a __file__-relative lookup in predictor.py — only set this to override.
ML_MODEL_PATH=src/backend/ml_service/weather_rainfall_model.pkl

# Absolute path to archive.zip used by the satellite-predict endpoint's
# zip-fallback mode (POST /api/satellite-predict/ with image_path field).
# Set to the actual location of your INSAT-3D zip dataset.
ML_ZIP_PATH=/home/gridguard/datasets/archive.zip

# Timeout in seconds for the Open-Meteo live weather API calls.
# Raise if you are on a slow network; lower to fail fast in production.
# Open-Meteo is free and requires no API key.
OPEN_METEO_TIMEOUT=5

# Open-Meteo base URL — only override for a self-hosted / mirror instance.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast


# ── E. Frontend (Vanilla JS) ─────────────────────────────────────────────────

# Full origin of the Django REST API, used by app.js when the page is served
# over HTTP (VS Code Live Server, nginx, etc.).
# When the page is opened as a local file:// this is auto-resolved in code to
# http://127.0.0.1:<DJANGO_PORT> — this variable is for HTTP-served deployments.
DJANGO_API_ORIGIN=http://127.0.0.1:8000

# Port used by the frontend static file server (e.g. VS Code Live Server).
# Must match the Live Server extension setting if you change it.
FRONTEND_PORT=5500

# Build / version tag displayed in the dashboard UI heading readout.
# Change this when you release a new version.
GRID_BUILD_TAG=GRID-4.19

# Operational node identifier shown in the sidebar footer and console footer.
GRID_NODE_ID=LOC-127

# Sector identifier shown in the sidebar and auth portal card.
GRID_SECTOR=SECTOR 07


# ── F. Auth Simulation Portal ────────────────────────────────────────────────

# Endpoint path for the simulated login POST.
# Must match the path registered in src/backend/api/urls.py.
AUTH_SIMULATE_LOGIN_PATH=/api/auth/simulate-login/

# Token prefix used in the simulated session token (GRID-SIM-<timestamp>).
# Change to your own prefix if you fork this project.
AUTH_TOKEN_PREFIX=GRID-SIM

# Demo evaluator session pre-fill values (used by the "Enter as Demo Evaluator"
# bypass button in index.html — no backend call is made for this path).
AUTH_DEMO_NAME=Demo Evaluator
AUTH_DEMO_ROLE=EVALUATOR
AUTH_DEMO_ORG=GridGuard Hackathon Panel
AUTH_DEMO_ACCESS_TIER=EVALUATION
AUTH_DEMO_TOKEN=GRID-SIM-DEMO

# sessionStorage key under which the session object is stored in the browser.
# If you change this, update index.html and auth-guard.js to match.
AUTH_SESSION_KEY=gridguard_session


# =============================================================================
# QUICK-START CHECKLIST
# =============================================================================
# [ ] Copy to src/.env
# [ ] Replace DJANGO_SECRET_KEY with a real generated key
# [ ] Set DJANGO_DEBUG=False for any non-local deployment
# [ ] Set DJANGO_ALLOWED_HOSTS to your actual domain(s)
# [ ] Set DJANGO_CORS_ALLOW_ALL_ORIGINS=False and fill DJANGO_CORS_ALLOWED_ORIGINS
# [ ] Set ML_ZIP_PATH to the actual path of your archive.zip dataset
# [ ] Set DJANGO_DB_* if switching away from SQLite
# [ ] Confirm DJANGO_PORT matches CONFIG.DJANGO_PORT in app.js (default: 8000)
# [ ] Confirm FRONTEND_PORT matches your Live Server port (default: 5500)
# =============================================================================
